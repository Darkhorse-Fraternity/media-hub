# Core application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3051
TRUSTED_ORIGINS=http://localhost:3051
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_USE_SECURE_COOKIES=false
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/media_hub

# Idempotent administrator seed (`pnpm db:seed`)
MEDIA_HUB_SEED_ADMIN_NAME=Media Hub Admin
MEDIA_HUB_SEED_ADMIN_EMAIL=admin@example.com
MEDIA_HUB_SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# H3 / Ref2VA generation provider
MEDIA_HUB_GENERATION_PROVIDER_URL=http://provider-host:8000
MEDIA_HUB_GENERATION_PROVIDER_TOKEN=replace-with-provider-token
# Optional deployment defaults; administrators can override these in Settings.
MEDIA_HUB_H3_GENERATION_PROFILE=platform-h3-i2v-inline-v1
MEDIA_HUB_H3_EDIT_PROFILE=platform-h3-ref2va-edit-v1
FFMPEG_PATH=ffmpeg

# Shared GPU scheduling and original-audio dialogue validation
MEDIA_HUB_GPU_BROKER_URL=http://gpu-host:5090
# MEDIA_HUB_GPU_BROKER_TOKEN=replace-with-broker-token
# MEDIA_HUB_GPU_BROKER_TOKEN_FILE=/absolute/path/to/h3-broker.token
MEDIA_HUB_ASR_URL=http://gpu-host:8788
# Defaults to MEDIA_HUB_GENERATION_PROVIDER_TOKEN when omitted.
# MEDIA_HUB_ASR_TOKEN=replace-with-asr-token
MEDIA_HUB_ASR_MIN_SIMILARITY=0.72

# Media storage (AWS S3 or another S3-compatible service)
MEDIA_HUB_S3_REGION=us-east-1
MEDIA_HUB_S3_BUCKET=replace-with-bucket
MEDIA_HUB_S3_ACCESS_KEY=replace-with-access-key
MEDIA_HUB_S3_SECRET_KEY=replace-with-secret-key
# MEDIA_HUB_S3_ENDPOINT=https://s3-compatible-endpoint.example.com

# Encryption for stored platform credentials
MEDIA_HUB_CRYPTO_KEY=replace-with-32-byte-key

# Prompt optimization worker (deployment defaults; Admin Settings can override)
CODEX_WORKER_URL=
CODEX_WORKER_SOURCE=media-hub
CODEX_TIMEOUT_MS=120000

# Optional local AI suggestions (deployment defaults; Admin Settings can override)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3-vl:32b

# YouTube OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3051/oauth/youtube/callback

# Instagram / Meta OAuth
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_FACEBOOK_PAGE_IDS=
META_OAUTH_REDIRECT_URI=http://localhost:3051/oauth/instagram/callback
META_API_VERSION=v23.0

# Optional proxy
# HTTP_PROXY=
# HTTPS_PROXY=

# Logging
LOG_LEVEL=info
SERVICE_NAME=media-hub
